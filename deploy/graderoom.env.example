# The port decides the database when BETA is unset, so leave it at 5996 for a stable
# instance. BETA=false forces stable on any port, which is what a host that assigns
# the port needs. PaaS hosts set PORT in upper case, which is read too.
port=5996
BETA=false

# The address to listen on. 127.0.0.1 means the tunnel is the only way in, which is
# what you want when the box is reachable from the internet. Leave it empty to listen
# on every interface, which is what the upstream server does.
HOST=127.0.0.1

# A long random string, and not the one below. Changing it logs everyone out.
#   openssl rand -base64 48
SECRET=

# MongoDB. MongoDB Atlas M0 is free forever at 512 MB, or use a local mongod.
# With a username and a password in it, keep this file readable only by root.
DB_URL=mongodb://127.0.0.1:27017

# Redis. Leave it unset when Redis is on the same machine, and the port-derived
# local default is used.
# REDIS_URL=redis://127.0.0.1:6379

# Only needed for password reset by email. Leave them blank to skip it: a forgotten
# password is then recovered with scripts/set-password.js, which needs shell access.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Only needed if people sign up through the site. scripts/create-users.js does not
# need them, so a private instance can leave them blank.
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=

# The Chrome extension ID of the build your users install. Without it the chip will
# say the extension is not installed.
TEST_EXTENSION_ID=
